# --- COROS OAuth ---
# The full callback URL Vercel will serve once deployed, e.g.
# https://your-project.vercel.app/api/coros/callback
COROS_REDIRECT_URI=

# --- GitHub (for the cron job to commit updated data files) ---
# Fine-grained Personal Access Token scoped to just this repo,
# "Contents: Read and write" permission only.
# NOT the same thing as "Claude connected to GitHub" in the chat UI —
# this is a separate credential the deployed app uses at runtime.
GITHUB_TOKEN=
GITHUB_OWNER=RifqiFachruradzi
GITHUB_REPO=coros-running-dashboard
GITHUB_BRANCH=main

# --- Cron security ---
# Any random string. Vercel automatically sends it as
# `Authorization: Bearer <value>` when invoking scheduled cron requests;
# this route checks it matches so no one else can trigger a sync.
CRON_SECRET=

# --- Vercel KV (Upstash Redis) ---
# Auto-injected when you enable the "Vercel KV" storage integration on the
# project — no need to set these by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
